# Copy values into Vercel Production environment variables, then redeploy.
# Generate the two keys with: npm run push:keys
VAPID_PUBLIC_KEY=your-generated-public-key
VAPID_PRIVATE_KEY=your-generated-private-key
VAPID_SUBJECT=mailto:your-real-contact-email
PUSH_APP_URL=https://your-production-domain
QSTASH_TOKEN=your-upstash-qstash-token
# Optional: use the API URL shown by your QStash console for your region.
QSTASH_URL=https://qstash.upstash.io
# Keep the existing NEXTAUTH_SECRET. It signs the scheduled callback requests.
