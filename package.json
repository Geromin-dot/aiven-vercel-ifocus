{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test:timer": "node --test scripts/timer-state.test.mjs scripts/timer-sync.test.mjs scripts/timer-notifications.test.mjs scripts/timer-notification-delivery.test.mjs scripts/presence-push.test.mjs scripts/study-stats.test.mjs scripts/focus-clock.test.mjs",
    "push:keys": "node scripts/generate-push-keys.mjs",
    "test:reflection": "node --test scripts/reflection-input.test.mjs",
    "test:coach": "node --test scripts/coach-signals.test.mjs scripts/coach-resilience.test.mjs scripts/reflection-input.test.mjs",
    "push:setup-db": "prisma db execute --schema prisma/schema.prisma --file prisma/push-notifications.sql",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "dotenv": "^17.4.2",
    "next": "16.3.1",
    "next-auth": "^4.24.15",
    "react": "19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4"
  }
}
